{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-hono-app",
  "compatibility_date": "2025-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./app/server.tsx",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "env": {
    "staging": {
      "name": "my-hono-app-dev",
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
      }
    },
    "production": {
      "name": "my-hono-app-prod",
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
      }
    }
  }
}
