# scripts/init-secrets.sh が読み込む設定。
# このファイルを `.env.secret` にコピーして値を埋める:
#   cp .env.secret.example .env.secret
#
# 値の取得方法:
#   turso db show <project>-dev  --url      # → TURSO_DATABASE_URL_STAGING
#   turso db tokens create <project>-dev    # → TURSO_AUTH_TOKEN_STAGING
#   turso db show <project>-prod --url      # → TURSO_DATABASE_URL_PRODUCTION
#   turso db tokens create <project>-prod   # → TURSO_AUTH_TOKEN_PRODUCTION

# staging (= develop ブランチ / Worker: <project>-dev)
TURSO_DATABASE_URL_STAGING=
TURSO_AUTH_TOKEN_STAGING=

# production (= main ブランチ / Worker: <project>-prod)
TURSO_DATABASE_URL_PRODUCTION=
TURSO_AUTH_TOKEN_PRODUCTION=
